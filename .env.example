# Provider order: the first is primary; when its free quota runs out, the next one is used.
PROVIDER_ORDER=nvidia,ollama

# NVIDIA NIM (build.nvidia.com, free tier)
NVIDIA_API_KEY=
NVIDIA_URL=https://integrate.api.nvidia.com/v1
# Preference list: the first model found in the catalog is used
NVIDIA_MODELS=deepseek-ai/deepseek-v3.2,deepseek-ai/deepseek-v3.1-terminus,deepseek-ai/deepseek-v3.1,qwen/qwen3-235b-a22b,meta/llama-3.3-70b-instruct

# Ollama Cloud (ollama.com, free tier)
OLLAMA_API_KEY=
OLLAMA_URL=https://ollama.com/v1
OLLAMA_MODELS=gpt-oss:120b,gemma4:31b,nemotron-3-super,gpt-oss:20b

# Subtitles per LLM request
BATCH_SIZE=30
